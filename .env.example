# Copy to .env.local for development. Set the same keys in Vercel → Project → Settings → Environment Variables.

# Public site URL (no trailing slash). Used for Stripe redirect URLs, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=https://meilechbiller.com

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key (server only, bypasses RLS). Legacy "service_role" JWT also works.
SUPABASE_SECRET_KEY=sb_secret_...

# Stripe → Developers → API keys / Webhooks
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Random 32+ byte secret used to sign client gallery access cookies.
# Generate with: openssl rand -base64 32
GALLERY_COOKIE_SECRET=change-me
