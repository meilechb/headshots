# Copy to .env.local for development. Set the same keys in Vercel → Project → Settings → Environment Variables.

# Public site URL (no trailing slash). Used for Stripe redirect URLs, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=https://meilechbiller.com

# Neon → your project → Connect → connection string (pooled is fine)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Vercel Blob. Create two stores in the Vercel project (Storage → Create → Blob):
#   "galleries"  access: Private  → token goes in BLOB_READ_WRITE_TOKEN
#   "portfolio"  access: Public   → token goes in PORTFOLIO_READ_WRITE_TOKEN (Vercel adds it when the store's env var prefix is PORTFOLIO)
# (When you connect a store to the project, Vercel adds its token automatically; set the
#  env var prefix to PORTFOLIO for the public store in the store's Advanced Options.)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
PORTFOLIO_READ_WRITE_TOKEN=vercel_blob_rw_...

# Studio login (single admin). Create the hash with:  npm run hash-password -- "your password"
ADMIN_EMAIL=you@meilechbiller.com
ADMIN_PASSWORD_HASH=scrypt:16384:...:...

# Random 32+ byte secret for admin sessions and client gallery cookies.  openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# Stripe → Developers → API keys / Webhooks
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (optional but recommended). Create a free Resend account, verify your domain,
# then create an API key. Without a key the site still works: inquiries are saved and
# the admin gets mailto links instead of automatic emails.
RESEND_API_KEY=re_...
# Must be an address on the verified domain. Format: Name <email@domain>
EMAIL_FROM=Meilech Biller <hello@meilechbiller.com>
# Where new-inquiry notifications go (defaults to ADMIN_EMAIL)
INQUIRY_NOTIFY_EMAIL=
